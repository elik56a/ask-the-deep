# Copy to api/.env. Without it the API runs on the free built-in "test" model.
LLM_MODEL=google:gemini-3.5-flash-lite
EMBEDDING_MODEL=google:gemini-embedding-001
GOOGLE_API_KEY=
DATABASE_URL=postgresql://portfolio:portfolio@localhost:5432/portfolio
DYNAMODB_TABLE=portfolio-chat-local-counters

# Langfuse configuration. If you don't have a Langfuse account, you can sign up for free at https://www.langfuse.com.
LANGFUSE_SECRET_KEY="your-secret-key"
LANGFUSE_PUBLIC_KEY="your-public-key"
LANGFUSE_BASE_URL="https://us.cloud.langfuse.com"
