{
  "name": "web",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 5173 --strictPort",
    "generate-routes": "tsr generate",
    "build": "vite build && node --experimental-strip-types --no-warnings scripts/apply-csp.ts",
    "preview": "vite preview",
    "format": "biome format",
    "lint": "biome lint",
    "check": "biome check",
    "gen:events": "uv run --directory ../api python -m app.schema_export | json2ts --bannerComment '// Generated from api/app/events.py by `pnpm gen:events`. Do not edit.' --additionalProperties false > src/generated/events.gen.ts",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@ai-sdk/react": "4.0.147",
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource-variable/heebo": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@marsidev/react-turnstile": "1.6.2",
    "@tanstack/react-router": "1.170.45",
    "@tanstack/react-start": "1.169.3",
    "ai": "7.0.143",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.0",
    "radix-ui": "1.8.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "10.1.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-cli": "^1.132.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "^6.0.1",
    "json-schema-to-typescript": "16.0.0",
    "shadcn": "4.22.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^5.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ],
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-vfj7-8cjw-p6xm"
      ]
    }
  }
}
